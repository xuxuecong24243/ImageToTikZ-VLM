# Copy this file to .env beside vlm_client.py, then fill the three required values.
# .env is ignored by Git. Never put real credentials in this example file.
# Process environment overrides project-root .env, regardless of working directory.
# API_BASE is a legacy alias; API_BASE_URL wins within the same source.
# Empty process values explicitly clear matching .env values.
# Values are literal: no shell execution, interpolation, or multiline settings.
# Use your provider's OpenAI-compatible base URL and exact vision-enabled model ID.
API_BASE_URL=
API_KEY=
MODEL_NAME=

# Optional; CLI > process environment > project .env > built-in default.
# Empty optional settings mean the built-in default. Loading never enables --allow-api.
# api.deepseek.com + deepseek-flash: 65536; other hosts/models: 12000.
API_MAX_OUTPUT_TOKENS=
# max_tokens (default), or max_completion_tokens for providers that document it.
# Official DeepSeek uses max_tokens.
API_TOKEN_LIMIT_PARAMETER=
# Optional stricter output cap. Official deepseek-flash can never exceed 393216.
# For other models set this from the provider's documented OUTPUT limit, not context size.
API_MODEL_OUTPUT_LIMIT=

# CLI > process environment > project .env > provider-specific default.
# Official api.deepseek.com + deepseek-flash defaults to disabled.
# For other providers, blank omits the field entirely.
API_THINKING_MODE=
# low | medium | high. Official DeepSeek enabled with no effort defaults to low.
# Disabled with no effort omits reasoning_effort. DeepSeek maps medium to high.
API_REASONING_EFFORT=
